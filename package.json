{
  "name": "kickstart-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check && eslint ./src",
    "lint:fix": "biome check --write && eslint ./src --fix",
    "fmt": "biome format --write",
    "fmt:check": "biome format",
    "model:generate": "npx tsx ./scripts/generateModel.ts",
    "model:import": "npx tsx ./scripts/importProject.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kontent-ai/delivery-sdk": "^16.4.0",
    "@kontent-ai/rich-text-resolver": "^3.0.2",
    "@portabletext/vue": "^1.0.14",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-query": "^5.92.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "dotenv": "^17.2.3",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@kontent-ai/biome-config": "^0.7.0",
    "@kontent-ai/data-ops": "^2.5.0",
    "@kontent-ai/model-generator": "^9.1.1",
    "@types/node": "^25.1.0",
    "@vue/tsconfig": "^0.8.1",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vue-tsc": "^3.2.4"
  }
}
